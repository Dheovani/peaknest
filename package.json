{
  "name": "fitness-platform",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @fitness/web dev",
    "dev:mobile": "pnpm --filter @fitness/mobile dev",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --project unit && pnpm --filter @fitness/mobile test",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage && pnpm --filter @fitness/mobile test:coverage",
    "test:e2e:web": "playwright test",
    "test:e2e:mobile": "maestro test tests/e2e/mobile",
    "build": "turbo run build",
    "db:migrate": "pnpm --filter @fitness/database migrate",
    "db:seed": "pnpm --filter @fitness/database seed"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-import": "^2.32.0",
    "jsdom": "^31.0.1",
    "postgres": "^3.4.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.20.0",
    "turbo": "^2.11.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
